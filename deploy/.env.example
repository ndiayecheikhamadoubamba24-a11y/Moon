# ===== Moon — configuration du serveur (copier en deploy/.env puis remplir) =====

# Domaine du site (sans https://). Le DNS doit pointer vers l'adresse IP du serveur.
SITE_DOMAIN=moon.sn
# E-mail pour le certificat HTTPS (Let's Encrypt)
ACME_EMAIL=tech@moon.sn

# Clé de chiffrement Laravel : la générer UNE SEULE FOIS (voir le guide), puis ne JAMAIS la changer :
# les notes du journal sont chiffrées avec. Garde-en aussi une copie en lieu sûr, hors du serveur.
APP_KEY=

# Mot de passe de la base de données (long et aléatoire)
DB_PASSWORD=

# Liens des stores (vides tant que l'app n'est pas publiée)
PLAY_STORE_URL=
APP_STORE_URL=
CONTACT_EMAIL=contact@moon.sn

# Notifications push Expo (facultatif : expo.dev → Access tokens)
EXPO_ACCESS_TOKEN=

# Chatbot Fatou (facultatif)
ANTHROPIC_API_KEY=

# E-mails (facultatif ; sans réglage, les e-mails sont seulement écrits dans les journaux)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@moon.sn
